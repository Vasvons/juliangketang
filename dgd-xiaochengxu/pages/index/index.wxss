/* pages/index/index.wxss */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-top: 16rpx;
}

.section-left {
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.arrow {
  margin-left: 4rpx;
}

.course-list {
  padding: 0 24rpx;
}

.bottom-safe {
  height: 40rpx;
}
