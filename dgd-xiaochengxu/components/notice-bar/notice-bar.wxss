/* components/notice-bar/notice-bar.wxss */
.notice-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  height: 40rpx;
  overflow: hidden;
  position: relative;
}

.notice-scroll-wrapper {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  white-space: nowrap;
}

.notice-scroll-track {
  display: inline-block;
  white-space: nowrap;
  animation: notice-scroll 12s linear infinite;
}

.notice-text {
  display: inline-block;
  font-size: 26rpx;
  color: #666666;
  line-height: 40rpx;
  padding-right: 80rpx;
}

@keyframes notice-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}
