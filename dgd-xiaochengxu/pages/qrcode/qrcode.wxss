/* pages/qrcode/qrcode.wxss */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.qrcode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 60rpx;
}

.qrcode-image {
  width: 500rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.save-tip {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #999;
}
