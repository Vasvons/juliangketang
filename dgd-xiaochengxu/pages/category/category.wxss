/* pages/category/category.wxss */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
}

.category-list {
  padding: 0 24rpx;
}

.category-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.category-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}

.category-icon-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.category-icon-text {
  font-size: 32rpx;
  font-weight: 500;
}

.category-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.category-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.bottom-safe {
  height: 40rpx;
}
