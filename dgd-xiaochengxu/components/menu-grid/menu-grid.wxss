/* components/menu-grid/menu-grid.wxss */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 12rpx;
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.menu-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.menu-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.menu-icon-text {
  font-size: 36rpx;
  font-weight: 500;
}

.menu-name {
  font-size: 24rpx;
  color: #333;
}
