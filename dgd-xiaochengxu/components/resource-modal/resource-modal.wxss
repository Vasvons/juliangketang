/* components/resource-modal/resource-modal.wxss */
.resource-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.resource-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.resource-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  margin-bottom: 32rpx;
}

.resource-content {
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  padding: 24rpx;
  border-radius: 8rpx;
  word-break: break-all;
  white-space: pre-wrap;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.resource-actions {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.copy-btn {
  padding: 16rpx 48rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.resource-cancel {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}
