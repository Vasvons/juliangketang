/* pages/course-detail/course-detail.wxss */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.course-header {
  padding: 24rpx;
  background: #fff;
}

.course-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.course-meta {
  display: flex;
  align-items: center;
}

.course-date {
  font-size: 26rpx;
  color: #999;
  margin-right: 24rpx;
}

.course-category {
  font-size: 24rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.course-cover {
  width: 100%;
  display: block;
  background: #f0f0f0;
}

.section-block {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #ff6600;
}

.rich-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.chapter-list {
  padding-left: 12rpx;
}

.chapter-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.chapter-index {
  color: #ff6600;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.chapter-name {
  flex: 1;
}

.bottom-placeholder {
  height: 120rpx;
}

.disclaimer {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  padding: 24rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 102rpx;
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.action-left {
  flex: 1;
  display: flex;
  align-items: center;
  height: 100%;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.action-icon-activation {
  width: 46rpx;
  height: 46rpx;
}

.action-text {
  font-size: 20rpx;
  color: #888;
}

.action-get {
  flex-shrink: 0;
  width: 346rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #00c657;
  color: #fff;
  font-size: 30rpx;
  border-radius: 30rpx;
  margin-right: 38rpx;
}
