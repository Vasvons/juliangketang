<!--pages/profile/profile.wxml-->
<view class="page-container">
  <view class="profile-header">
    <view class="city-silhouette"></view>
    <view class="profile-info">
      <view class="avatar-box">
        <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <text wx:else class="avatar-default">👤</text>
      </view>
      <view class="profile-text">
        <view class="nickname">{{isLogin ? (userInfo.nickname || '微信用户') : '未登录'}}</view>
        <view class="level-tag">{{isLogin ? (userInfo.level_name || '普通用户') : '点击卡密激活'}}</view>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="onActivation">
      <text class="menu-icon">🔑</text>
      <text class="menu-text">卡密激活</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onService">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
